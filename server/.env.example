DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_manager
ACCESS_TOKEN=your_super_secret_access_token_key_here
REFRESH_TOKEN=your_super_secret_refresh_token_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional: Set this if you want to use OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
